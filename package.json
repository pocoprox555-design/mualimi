{
  "name": "mualimi",
  "private": true,
  "version": "8.0.0",
  "description": "معلمي — منصة تعلم عربية موثقة من كتب السادس الإعدادي",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "import-deni": "node scripts/import-deni-books.mjs",
    "build-index": "node scripts/build-index.mjs",
    "shard-index": "node scripts/shard-index.mjs",
    "rebuild-pdf-index": "node scripts/rebuild-pdf-index.mjs",
    "validate-index": "node scripts/validate-index.mjs",
    "gate": "node scripts/validate-index.mjs --gate",
    "verify": "npm run rebuild-pdf-index && npm run build-index && npm run build-shards && npm run gate",
    "build-shards": "node scripts/shard-index.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "pdfjs-dist": "^4.0.379"
