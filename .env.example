# مفتاح الذكاء الاصطناعي (يُشغّل النموذج الحقيقي عبر server.mjs)
# ضع مفتاحك هنا فقط ولا تشاركه أبدًا. بدون هذا المفتاح سيعرض التطبيق
# رسالة بضرورة ضبط المفتاح — لا توجد ردود محلية.
AI_API_KEY=
# النموذج الافتراضي. يجب أن يدعم استدعاء الأدوات + قراءة الصور (image_url)،
# لأن الوكيل يرسل صفحات PDF المصوّرة كصور.
AI_MODEL=MiMo-V2.6-Flash
AI_CONTEXT_WINDOW=1000000
AI_MAX_OUTPUT_TOKENS=131000
# نقطة النهاية المتوافقة مع Chat Completions
AI_ENDPOINT=https://opencode.ai/zen/go/v1/
# حد زمني تقني يمنع تعليق الوكيل؛ لا يفرض حصة استخدام.
AI_AGENT_TIMEOUT_MS=300000

# منفذ خادم الإنتاج؛ تضبطه CloudRun تلقائيًا
PORT=3000

# رمز طويل وعشوائي مطلوب لإدارة رفع/حذف الكتب في الإنتاج
# لا تضع هذا الرمز في الواجهة أو المستودع
CURRICULUM_ADMIN_TOKEN=
